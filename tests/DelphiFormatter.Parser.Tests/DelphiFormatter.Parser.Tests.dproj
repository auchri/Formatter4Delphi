<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{81C83CDF-77B5-45FB-9C9E-B202BAA283D1}</ProjectGuid>
        <ProjectVersion>20.1</ProjectVersion>
        <MainSource>DelphiFormatter.Parser.Tests.dpr</MainSource>
        <ProjectName>DelphiFormatter.Parser.Tests</ProjectName>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform>Win64</Platform>
        <TargetedPlatforms>2</TargetedPlatforms>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">DelphiFormatter.Parser.Tests</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>DelphiFormatter_Parser_Tests</SanitizedProjectName>
        <DCC_Namespace>System;$(DCC_Namespace)</DCC_Namespace>
        <DUnitXSource Condition="'$(DUnitXSource)'==''">$(BDS)\source\DUnitX</DUnitXSource>
        <DCC_UnitSearchPath>..\..\src\DelphiFormatter.Core;..\..\src\DelphiFormatter.Lexer;..\..\src\DelphiFormatter.Syntax;..\..\src\DelphiFormatter.Parser;$(DUnitXSource);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>$(DUnitXSource);$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_DcuOutput>..\..\build\$(Platform)\$(Config)\ParserTests</DCC_DcuOutput>
        <DCC_ExeOutput>..\..\build\$(Platform)\$(Config)</DCC_ExeOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>1</DCC_DebugInformation>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_OverflowChecking>true</DCC_OverflowChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_Optimize>true</DCC_Optimize>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\Fixtures\DeclarationCorpus.pas"/>
        <DCCReference Include="Tests.Parser.Basics.pas"/>
        <DCCReference Include="..\..\src\DelphiFormatter.Core\DelphiFormatter.Core.Spans.pas"/>
        <DCCReference Include="..\..\src\DelphiFormatter.Core\DelphiFormatter.Core.Diagnostics.pas"/>
        <DCCReference Include="..\..\src\DelphiFormatter.Lexer\DelphiFormatter.Lexer.Tokens.pas"/>
        <DCCReference Include="..\..\src\DelphiFormatter.Lexer\DelphiFormatter.Lexer.Keywords.pas"/>
        <DCCReference Include="..\..\src\DelphiFormatter.Lexer\DelphiFormatter.Lexer.Scanner.pas"/>
        <DCCReference Include="..\Fixtures\PostfixCorpus.pas"/>
        <DCCReference Include="..\Fixtures\ClassRecordCorpus.pas"/>
        <DCCReference Include="..\Fixtures\PropertyCorpus.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Console</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DelphiFormatter.Parser.Tests.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">False</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
