<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{FEC0574E-66EE-4B88-9B02-EE1296D72702}</ProjectGuid>
        <ProjectVersion>20.1</ProjectVersion>
        <MainSource>DelphiFormatter.Coverage.Tests.dpr</MainSource>
        <ProjectName>DelphiFormatter.Coverage.Tests</ProjectName>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform>Win64</Platform>
        <TargetedPlatforms>2</TargetedPlatforms>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">DelphiFormatter.Coverage.Tests</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>DelphiFormatter_Coverage_Tests</SanitizedProjectName>
        <DCC_Namespace>System;$(DCC_Namespace)</DCC_Namespace>
        <DUnitXSource Condition="'$(DUnitXSource)'==''">$(BDS)\source\DUnitX</DUnitXSource>
        <DCC_UnitSearchPath>..\..\src\DelphiFormatter.Core;..\..\src\DelphiFormatter.Lexer;..\..\src\DelphiFormatter.Syntax;..\..\src\DelphiFormatter.Parser;..\DelphiFormatter.Coverage;$(DUnitXSource);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>$(DUnitXSource);$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_DcuOutput>..\..\build\$(Platform)\$(Config)\CoverageTests</DCC_DcuOutput>
        <DCC_ExeOutput>..\..\build\$(Platform)\$(Config)</DCC_ExeOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>1</DCC_DebugInformation>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_OverflowChecking>true</DCC_OverflowChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_Optimize>true</DCC_Optimize>
    </PropertyGroup>
    <ItemGroup>
        <DCCReference Include="Tests.Coverage.pas"/>
        <DCCReference Include="..\DelphiFormatter.Coverage\Coverage.Analysis.pas"/>
        <DCCReference Include="..\DelphiFormatter.Coverage\Coverage.Reports.pas"/>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Console</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DelphiFormatter.Coverage.Tests.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">False</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
